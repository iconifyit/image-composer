{
    "name": "@atomiclotus/image-composer",
    "version": "0.2.1",
    "description": "Compose a set of images into a single output image via a small layout DSL (grids, |/ regions, CSS-grid-style track sizing). Pure library + CLI.",
    "keywords": [
        "image",
        "composite",
        "collage",
        "montage",
        "grid",
        "layout",
        "sharp",
        "cli"
    ],
    "license": "MIT",
    "author": "atomiclotus",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/iconifyit/image-composer.git"
    },
    "main": "src/index.js",
    "bin": {
        "image-composer": "cli/index.js"
    },
    "files": [
        "src",
        "cli",
        "README.md",
        "VERSION"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "postcss-value-parser": "^4.2.0",
        "sharp": "^0.33.5"
    },
    "devDependencies": {
        "eslint": "^9.13.0",
        "jest": "^29.7.0",
        "prettier": "^3.3.3"
    }
}
